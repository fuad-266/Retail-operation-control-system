                            "pm.test('paymentCurrency is KES', () => pm.expect(json.paymentCurrency).to.eql('KES'));",
                            "pm.test('amount is positive', () => pm.expect(Number(json.amount)).to.be.above(0));",
                            "pm.test('totalAmount present', () => pm.expect(json.totalAmount).to.exist);",
                            "pm.test('confirmedByName present', () => pm.expect(json.confirmedByName).to.be.a('string').and.not.empty);",
                            "pm.test('items array exists', () => pm.expect(json.items).to.be.an('array'));",
