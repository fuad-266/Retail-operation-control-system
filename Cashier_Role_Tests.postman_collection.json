        {
            "name": "💰 10. CASHIER — Confirm Payment (Cash / KES)",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Status 200', () => pm.response.to.have.status(200));",
                            "const json = pm.response.json();",
                            "pm.collectionVariables.set('receipt_number', json.receiptNumber);",
                            "pm.test('receiptNumber present', () => pm.expect(json.receiptNumber).to.match(/RCP-\\d{8}-\\d{4}/));",
