{
  "expo": {
    "name": "Adama shop",
    "slug": "adama-shop",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.jpg",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#381F12"
    },
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "backgroundColor": "#ffffff",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.anonymous.adamashop"
    },
    "web": {},
    "scheme": "retail-mobile",
    "plugins": [
      "expo-secure-store",
      "expo-image-picker"
    ],
    "extra": {
      "eas": {
        "projectId": "ba8bca3a-c5e3-4fc4-9244-507764fead37"
      }
    }
  }
}
