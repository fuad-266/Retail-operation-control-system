{
    "info": {
        "_postman_id": "cashier-role-full-test",
        "name": "🏪 Cashier Role — Complete Test Suite",
        "description": "Full end-to-end test coverage for the CASHIER role.\n\n**Setup:**\n1. Run requests in ORDER (they depend on each other via variables)\n2. The Login step auto-saves {{cashier_token}} and {{cashier_id}}\n3. Use the `OWNER - Create Cashier User` step once to seed a cashier account\n\n**Variables set automatically by tests:**\n- `cashier_token` — JWT bearer token\n- `cashier_id` — UUID of the logged-in cashier\n- `created_order_id` — UUID of a freshly created pending order\n- `created_reserved_id` — UUID of a freshly created reserved order\n- `receipt_number` — Receipt number from confirm payment\n- `product_id` — Grabbed from products list",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "base_url",
            "value": "http://localhost:8080"
        },
        {
            "key": "cashier_token",
            "value": ""
        },
        {
            "key": "cashier_id",
            "value": ""
        },
        {
            "key": "owner_token",
            "value": ""
        },
        {
            "key": "product_id",
            "value": ""
        },
        {
            "key": "created_order_id",
            "value": ""
        },
        {
            "key": "created_reserved_id",
            "value": ""
        },
        {
            "key": "receipt_number",
            "value": ""
        }
    ],
    "item": [
        {
            "name": "🔐 0. OWNER — Login (to create cashier user)",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Status 200', () => pm.response.to.have.status(200));",
                            "const json = pm.response.json();",
                            "pm.collectionVariables.set('owner_token', json.token);",
                            "pm.test('Got owner token', () => pm.expect(json.role).to.eql('OWNER'));"
                        ]
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "url": "{{base_url}}/api/auth/login",
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"email\": \"admin@shop.com\",\n  \"password\": \"password123\"\n}"
                }
            }
        },
        {
            "name": "👤 1. OWNER — Create Cashier User",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Status 201', () => pm.response.to.have.status(201));",
                            "const json = pm.response.json();",
                            "pm.test('Role is CASHIER', () => pm.expect(json.role).to.eql('CASHIER'));",
                            "pm.test('Has fullName', () => pm.expect(json.fullName).to.be.a('string'));"
                        ]
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    },
                    {
                        "key": "Authorization",
                        "value": "Bearer {{owner_token}}"
                    }
                ],
                "url": "{{base_url}}/api/users",
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"fullName\": \"Test Cashier\",\n  \"email\": \"cashier@shop.com\",\n  \"phoneNumber\": \"0700000001\",\n  \"password\": \"cashier123\",\n  \"role\": \"CASHIER\"\n}"
                }
            }
        },
        {
            "name": "🔑 2. CASHIER — Login",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Status 200', () => pm.response.to.have.status(200));",
                            "const json = pm.response.json();",
                            "pm.collectionVariables.set('cashier_token', json.token);",
                            "pm.collectionVariables.set('cashier_id', json.userId);",
                            "pm.test('Role is CASHIER', () => pm.expect(json.role).to.eql('CASHIER'));",
                            "pm.test('Token present', () => pm.expect(json.token).to.be.a('string').and.not.empty);",
                            "pm.test('UserId present', () => pm.expect(json.userId).to.be.a('string').and.not.empty);",
                            "console.log('✅ Cashier logged in. Token saved.');"
                        ]
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "url": "{{base_url}}/api/auth/login",
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"email\": \"cashier@shop.com\",\n  \"password\": \"cashier123\"\n}"
                }
            }
        },
        {
            "name": "🔑 2b. CASHIER — Login with wrong password (expect 401)",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Status 401 for bad credentials', () => pm.response.to.have.status(401));"
                        ]
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "url": "{{base_url}}/api/auth/login",
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"email\": \"cashier@shop.com\",\n  \"password\": \"WRONG_PASSWORD\"\n}"
                }
            }
        },
        {
            "name": "📦 3. CASHIER — Get Products List (grab product_id)",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Status 200', () => pm.response.to.have.status(200));",
                            "const json = pm.response.json();",
                            "pm.test('Returns an array', () => pm.expect(json).to.be.an('array'));",
                            "if (json.length > 0) {",
                            "  const active = json.find(p => p.active !== false) || json[0];",
                            "  pm.collectionVariables.set('product_id', active.id);",
                            "  console.log('✅ product_id set to: ' + active.id + ' (' + active.name + ')');",
                            "  pm.test('Product has id', () => pm.expect(active.id).to.be.a('string'));",
                            "  pm.test('Product has name', () => pm.expect(active.name).to.be.a('string'));",
                            "  pm.test('Product has price', () => pm.expect(active.price).to.exist);",
                            "} else {",
                            "  console.warn('⚠️ No products found — create a product via OWNER first');",
                            "}"
                        ]
                    }
                }
            ],
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{cashier_token}}"
                    }
                ],
                "url": "{{base_url}}/api/products"
            }
        },
        {
            "name": "🛒 4. CASHIER — Create Pending Order (in-store walk-in)",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Status 201', () => pm.response.to.have.status(201));",
                            "const json = pm.response.json();",
                            "pm.collectionVariables.set('created_order_id', json.id);",
                            "pm.test('Order id present', () => pm.expect(json.id).to.be.a('string'));",
                            "pm.test('Status is PENDING', () => pm.expect(json.status).to.eql('PENDING'));",
                            "pm.test('Has items', () => pm.expect(json.items).to.be.an('array').that.is.not.empty);",
                            "pm.test('totalAmountKes is positive', () => pm.expect(Number(json.totalAmountKes)).to.be.above(0));",
                            "pm.test('totalAmountEtb present', () => pm.expect(json.totalAmountEtb).to.exist);",
                            "pm.test('sellerName present', () => pm.expect(json.sellerName).to.be.a('string'));",
                            "console.log('✅ Order created: ' + json.id);"
                        ]
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    },
                    {
                        "key": "Authorization",
                        "value": "Bearer {{cashier_token}}"
                    }
                ],
                "url": "{{base_url}}/api/orders",
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"customerName\": \"Walk-in Customer\",\n  \"items\": [\n    {\n      \"productId\": \"{{product_id}}\",\n      \"quantity\": 1\n    }\n  ]\n}"
                }
            }
        },
