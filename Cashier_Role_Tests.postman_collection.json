        {
            "name": "🚫 14. CASHIER — Cancel OWN Order (should work)",
            "event": [
                {
                    "listen": "prerequest",
                    "script": {
                        "exec": [
                            "// This creates a fresh order that we'll cancel",
                            "const product_id = pm.collectionVariables.get('product_id');",
                            "const token = pm.collectionVariables.get('cashier_token');",
                            "pm.sendRequest({",
                            "  url: pm.collectionVariables.get('base_url') + '/api/orders',",
                            "  method: 'POST',",
                            "  header: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },",
                            "  body: { mode: 'raw', raw: JSON.stringify({ customerName: 'Cancel Test', items: [{ productId: product_id, quantity: 1 }] }) }",
                            "}, function(err, res) {",
                            "  if (res && res.code === 201) {",
                            "    pm.collectionVariables.set('cancel_order_id', res.json().id);",
                            "    console.log('Pre-created order to cancel: ' + res.json().id);",
                            "  }",
                            "});"
                        ]
                    }
                },
